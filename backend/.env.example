# Server
PORT=3000
ENV=development

# Database (SQLite default — no changes needed for local dev)
DB_TYPE=sqlite
DB_PATH=./data/lyftr.db

# PostgreSQL (only used if DB_TYPE=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=lyftr
# DB_USER=postgres
# DB_PASSWORD=

# Auth
# Required in production: a random string of at least 32 characters. Generate
# one with `openssl rand -hex 32`. Outside production, leaving this unset makes
# the server mint a random ephemeral secret at boot (sessions won't survive a
# restart) rather than fall back to a shared default anyone could forge tokens
# with. Rotating this value logs out every user.
JWT_SECRET=
JWT_EXPIRY=3600

# Admin — comma-separated emails allowed to call the /admin/* endpoints
# (exercise-library sync/reset). Unset = admin surface closed to everyone.
# ADMIN_EMAILS=you@example.com

# Demo seeding — the demo user (demo@lyftr.local / password123) and demo
# workout/food data. OFF everywhere unless explicitly set to true — the demo
# account has a publicly documented password, so it must never appear on an
# instance holding real data.
# SEED_DEMO=true

# Sends blood-pressure history and body metrics to the AI provider configured
# above, to generate written health insights. Deliberately separate from
# VISION_PROVIDER so that enabling meal-photo scanning does NOT also start
# exporting health records. Each user must additionally opt in under
# Settings > Privacy — this flag only makes the option available.
AI_HEALTH_INSIGHTS_ENABLED=false

# CORS — comma-separated allow-list of client origins permitted to call the API.
# Prefer listing real origins. `*` works (the API is Bearer-token based, so no
# cookies are at risk) but it gives up CORS as a defence-in-depth layer.
CORS_ORIGIN=http://localhost:5173

# Registration is closed by default: a self-hosted instance normally has a fixed
# set of accounts, so an open signup endpoint is attack surface with no upside.
# Turn it on long enough to create accounts, then turn it back off. Setting an
# invite code additionally requires callers to present it.
ALLOW_REGISTRATION=false
# REGISTRATION_INVITE_CODE=

# ── Session length ───────────────────────────────────────────────────────────
# A refresh token is a bearer credential held in the browser, so its lifetime is
# the window an attacker gets from a single theft. Rather than picking one
# number for everybody, sessions are split in two: a short default, and a longer
# one the user opts into per device with "Keep me signed in".
#
# Logging out, removing a device under Settings → Sessions, changing your
# password, or deleting your account revokes tokens regardless of these values.

# Lifetime in hours for a session the user did NOT ask to be remembered — a
# shared or borrowed browser. Default 12.
# REFRESH_EXPIRY=12

# Ceiling on the per-user "stay signed in for" preference, in days. The
# preference is user-editable, so this is the bound they cannot raise; a request
# above it is rejected. Default 90.
# MAX_SESSION_DAYS=90

# Hard cap on how long one session can live in total, in days, however actively
# it is used. Each use slides the refresh window forward, so without this a
# device opened daily would never sign out. Raised to MAX_SESSION_DAYS if set
# lower. Default 180.
# SESSION_ABSOLUTE_DAYS=180

# ── Passkeys (WebAuthn) ──────────────────────────────────────────────────────
# Off unless WEBAUTHN_RP_ID is set. It must be the hostname you actually reach
# Lyftr at, and it cannot be guessed for you: WebAuthn binds every credential to
# this value, so changing it later makes enrolled passkeys permanently unusable.
#
# Two hard requirements, both from the browser rather than from Lyftr:
#   - It must be a real hostname. A bare LAN IP (192.168.1.20) is not a valid
#     RP ID, so an instance reached that way cannot use passkeys at all.
#   - It must be served over HTTPS. Only localhost is exempt.
# WEBAUTHN_RP_ID=lyftr.example.com

# Full origins allowed to complete a ceremony. Defaults to https:// + the RP ID,
# which is right unless you serve the same instance on several hostnames.
# WEBAUTHN_RP_ORIGINS=https://lyftr.example.com

# What the passkey is called in the user's keychain or password manager.
# WEBAUTHN_RP_NAME=Lyftr

# Comma-separated CIDRs/IPs allowed to set X-Forwarded-For. Empty (the default)
# means trust no proxy and use the direct peer address. Set this to your reverse
# proxy's network when running behind one, or the auth rate limiter will bucket
# every request under the proxy's IP. Never set it to a range you don't control:
# anything inside it can forge its own source IP and bypass rate limiting.
# TRUSTED_PROXIES=172.16.0.0/12

# ExerciseDB (RapidAPI)
# Sign up free at https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
# Paste your key below — exercises are fetched once and stored locally.
# EXERCISEDB_KEY=your_rapidapi_key_here

# USDA FoodData Central — strongly recommended for US products. FDC's Branded
# dataset is manufacturer-submitted Nutrition Facts panels, so a search or
# barcode scan returns the values printed on the box, for the serving printed on
# the box, rather than a per-100g figure you have to rescale. It also publishes
# household-measure gram weights (1 tbsp = 13.8 g) for whole foods, which is
# what lets the portion picker offer exact tbsp/cup amounts.
#
# Without it, search and barcode fall back to Open Food Facts alone: good
# coverage, crowdsourced quality, and often per-100g only.
#
# Free key: https://fdc.nal.usda.gov/api-key-signup.html — 1,000 requests/hour.
# DEMO_KEY works but is capped at 30/hour and will 429 almost immediately.
# FDC_API_KEY=your_fdc_key_here

# Nutrition label photo import (optional) — pick ONE provider and set its key.
# Leave VISION_PROVIDER unset to disable the feature (scan requests return 503).
# VISION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here
# GEMINI_API_KEY=your_gemini_key_here

# Optional: override the model used by the active VISION_PROVIDER. Leave unset
# to use the built-in default (currently claude-opus-4-8 / gpt-4o / gemini-2.0-flash).
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.0-flash

# Where persisted meal photos (from the "describe your meal" photo analysis
# feature) are stored on disk, one subdirectory per user. Defaults to a
# subdirectory under the sqlite data dir so it rides the same volume/mount.
# MEAL_PHOTO_DIR=./data/meal-photos

# Where exercise demonstration frames are cached on disk. The library's images
# come from a public GitHub repo and are downloaded lazily on first view, then
# served locally — so the app works offline in a gym with no signal and does
# not hot-link ~870 exercises' worth of traffic off someone else's host.
# Fully warmed this is roughly 70 MB. Defaults to a subdirectory under the
# sqlite data dir so it rides the same volume/mount.
# EXERCISE_IMAGE_DIR=./data/exercise-images

# Which upstream dataset seeds the exercise library: "free" (free-exercise-db,
# default — two-frame photo crossfade) or "gymvisual" (hasaneyldrm/exercises-
# dataset — real animated GIF per exercise, copyrighted by Gymvisual and NOT
# covered by that dataset repo's own license; review
# https://github.com/hasaneyldrm/exercises-dataset's terms before enabling
# this on anything beyond a personal, non-redistributed instance).
#
# Switching this on a fresh/empty install is a normal choice of source. On an
# install that already has workouts/programs, changing it does NOT migrate
# existing data by itself — the two datasets share zero exact exercise names,
# so a plain re-seed just adds the new library alongside the old one. Use the
# admin exercise-migration flow (Settings > Exercise Library in the web app,
# or POST /api/v1/admin/exercise-migration/preview then /confirm) to move
# existing workouts/programs onto the new library and remove the old one —
# then update this var to match, since a completed migration only changes the
# running process's in-memory value.
# EXERCISE_LIBRARY_SOURCE=free
